# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 커밋되지 않습니다)
# docker compose 는 .env 를 자동으로 읽습니다. 애플리케이션 실행 시에는 셸에서 export 하거나 IDE 실행 설정에 등록하세요.
DB_USERNAME=biner
DB_PASSWORD=change_me

# 바이낸스 API 키 (테스트넷 키로 먼저 검증하세요)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 운영 전환 시 (기본값은 테스트넷)
# BINANCE_API_URL=https://fapi.binance.com
# BINANCE_MARKET_WS_URL=wss://fstream.binance.com/ws
# BINANCE_USER_WS_URL=wss://fstream.binance.com/ws

# 텔레그램 알림 (선택)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
